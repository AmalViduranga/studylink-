# Normalize text files to LF by default
* text=auto eol=lf

# Maven Wrapper scripts must keep their native line endings
mvnw text eol=lf
*.sh text eol=lf
mvnw.cmd text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Java, Maven, Markdown and configuration files
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary assets
*.pdf binary
*.jar binary
*.p12 binary
*.pfx binary
*.jks binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
